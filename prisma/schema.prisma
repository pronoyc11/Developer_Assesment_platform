generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") directUrl = env("DIRECT_URL") }
enum Role { CANDIDATE COMPANY ADMIN }
enum AssessmentStatus { DRAFT PENDING_PAYMENT PUBLISHED ACTIVE CLOSED ARCHIVED }
enum QuestionType { MCQ WRITTEN CODING }
enum InvitationStatus { PENDING ACCEPTED DECLINED EXPIRED }
enum AttemptStatus { IN_PROGRESS SUBMITTED EXPIRED EVALUATED }
enum PaymentStatus { PENDING PAID FAILED CANCELLED REFUNDED }
model User { id String @id @default(uuid()); email String @unique; passwordHash String?; name String; role Role; isActive Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; deletedAt DateTime?; companyProfile CompanyProfile?; candidateProfile CandidateProfile?; assessments Assessment[]; invitations Invitation[]; attempts Attempt[]; evaluations Evaluation[]; refreshTokens RefreshToken[]; auditLogs AuditLog[]; @@index([role, isActive]); @@index([deletedAt]) }
model CompanyProfile { id String @id @default(uuid()); userId String @unique; companyName String; website String?; description String?; user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model CandidateProfile { id String @id @default(uuid()); userId String @unique; headline String?; bio String?; skills String[]; user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model Assessment { id String @id @default(uuid()); companyId String; title String; description String?; durationMinutes Int; availableFrom DateTime; availableUntil DateTime; maxAttempts Int @default(1); price Int @default(0); status AssessmentStatus @default(DRAFT); publishedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; deletedAt DateTime?; company User @relation(fields:[companyId], references:[id]); questions AssessmentQuestion[]; invitations Invitation[]; attempts Attempt[]; payments Payment[]; @@index([companyId, status]); @@index([status, createdAt]) }
model Question { id String @id @default(uuid()); type QuestionType; text String; options Json?; correctOption String?; expectedSolution String?; marks Int; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; deletedAt DateTime?; assessments AssessmentQuestion[]; answers Answer[] }
model AssessmentQuestion { assessmentId String; questionId String; order Int; assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete: Cascade); question Question @relation(fields:[questionId], references:[id], onDelete: Cascade); @@id([assessmentId, questionId]); @@index([assessmentId, order]) }
model Invitation { id String @id @default(uuid()); assessmentId String; candidateId String; email String; status InvitationStatus @default(PENDING); invitedAt DateTime @default(now()); respondedAt DateTime?; assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete: Cascade); candidate User @relation(fields:[candidateId], references:[id]); @@unique([assessmentId, candidateId]); @@index([candidateId, status]) }
model Attempt { id String @id @default(uuid()); assessmentId String; candidateId String; attemptNumber Int; startedAt DateTime @default(now()); expiresAt DateTime; submittedAt DateTime?; evaluatedAt DateTime?; status AttemptStatus @default(IN_PROGRESS); score Float?; assessment Assessment @relation(fields:[assessmentId], references:[id]); candidate User @relation(fields:[candidateId], references:[id]); answers Answer[]; @@unique([assessmentId, candidateId, attemptNumber]); @@index([candidateId, status]) }
model Answer { id String @id @default(uuid()); attemptId String; questionId String; response String?; objectiveScore Float?; evaluatorScore Float?; feedback String?; attempt Attempt @relation(fields:[attemptId], references:[id], onDelete: Cascade); question Question @relation(fields:[questionId], references:[id]); evaluation Evaluation?; @@unique([attemptId, questionId]) }
model Evaluation { id String @id @default(uuid()); answerId String @unique; evaluatorId String; score Float; feedback String?; createdAt DateTime @default(now()); answer Answer @relation(fields:[answerId], references:[id], onDelete: Cascade); evaluator User @relation(fields:[evaluatorId], references:[id]); }
model Payment { id String @id @default(uuid()); assessmentId String; companyId String; stripeSessionId String? @unique; amount Int; currency String @default("usd"); status PaymentStatus @default(PENDING); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; assessment Assessment @relation(fields:[assessmentId], references:[id]); company User @relation(fields:[companyId], references:[id]); @@index([companyId, status]) }
model AuditLog { id String @id @default(uuid()); actorId String?; action String; entityType String; entityId String?; metadata Json?; createdAt DateTime @default(now()); actor User? @relation(fields:[actorId], references:[id], onDelete: SetNull); @@index([action, createdAt]); @@index([actorId, createdAt]) }
model RefreshToken { id String @id @default(uuid()); userId String; tokenHash String @unique; expiresAt DateTime; revokedAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, revokedAt]) }
