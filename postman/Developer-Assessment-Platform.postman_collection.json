          "description": "Uses the Postman cookie jar. For an existing imported request, set Authorization to No Auth and remove any stale Bearer header; the server prioritizes Authorization when present."
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/users/me/avatar"
          },
          "description": "Body → form-data; key avatar; Type File. JPEG/PNG/WebP, maximum 5 MB. Select the image in Postman."
        }
      ]
