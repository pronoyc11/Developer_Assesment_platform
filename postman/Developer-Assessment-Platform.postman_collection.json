{
  "info": {
    "name": "Developer Assessment Platform API",
    "description": "Requests for implemented API routes only. Replace literal sample IDs, credentials, OTPs, invitation tokens, and bearer values directly in request fields. Do not add Postman variables other than baseUrl. Postman stores auth cookies automatically after login where the server sets them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "description": "No authentication. Returns service health without secrets."
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Candidate\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"CandidatePass123!\",\n  \"role\": \"CANDIDATE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "description": "Public. Use a unique email. Registration sends an OTP; the database user is created after email verification."
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/verify-email"
          },
          "description": "Public. Replace the example OTP with the six-digit code received by email. Success sets HttpOnly access and refresh cookies."
        },
        {
          "name": "Resend verification OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/resend-verification"
          },
          "description": "Public. Redis cooldown and privacy-preserving response apply."
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"CandidatePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "description": "Public. Successful login sets HttpOnly auth cookies."
        },
        {
          "name": "Google login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"PASTE_VALID_GOOGLE_ID_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/google"
          },
          "description": "Public when Google OAuth is configured. Replace the literal example with a valid Google ID token."
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "description": "Refresh token may be supplied in JSON or the HttpOnly refreshToken cookie. Rotation revokes the old token."
        },
        {
          "name": "Refresh token alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/refresh-token"
          },
          "description": "Alias for POST /auth/refresh."
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/logout"
          },
          "description": "Revokes the refresh token and clears auth cookies."
        },
        {
          "name": "Authenticated identity probe",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "PASTE_ACCESS_JWT",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/auth-test/me"
          },
          "description": "Temporary auth middleware probe. Replace the literal bearer example directly or use a saved auth cookie."
        }
      ]
    },
    {
      "name": "Users",
      "auth": {
        "type": "noauth"
      },
      "description": "Authenticated user routes use the accessToken cookie saved by Postman after login. No Authorization header is sent by this folder.",
      "item": [
        {
          "name": "Get own profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
